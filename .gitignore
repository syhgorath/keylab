id_ed25519*
*.pem
*.key
# Çalışma çıktıları
usb_logs/
*.bak

# macOS gürültüsü (Finder, Spotlight, harici disklerdeki AppleDouble dosyaları)
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
